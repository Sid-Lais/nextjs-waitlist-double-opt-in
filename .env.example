# Public URL of the app. Used in email links.
APP_URL=http://localhost:3000

# SQLite file. On Vercel the filesystem is not persistent, use Postgres (see README).
DATABASE_URL=./data/waitlist.db

# Mailtrap Email API (Settings -> API Tokens, token needs access to your sending domain)
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=hello@your-domain.com
MAILTRAP_FROM_NAME=Your Product

# Template UUIDs. `npm run templates:sync` creates the templates and prints these.
MAILTRAP_TEMPLATE_CONFIRM=
MAILTRAP_TEMPLATE_WELCOME=
MAILTRAP_TEMPLATE_MOVED_UP=
MAILTRAP_TEMPLATE_LAUNCH=

# Optional: send everything to an Email Testing inbox instead of real recipients.
# Needed for `npm run e2e`. The free sandbox plan allows about 1 email per 10 s, sends are paced to match.
MAILTRAP_ACCOUNT_ID=
MAILTRAP_TEST_INBOX_ID=

# Signing secret of the Mailtrap webhook pointing at /api/webhooks/mailtrap
MAILTRAP_WEBHOOK_SECRET=

# Places a referrer moves up per confirmed referral
REFERRAL_BUMP_PLACES=3
